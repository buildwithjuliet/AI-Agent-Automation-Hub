    {
      "parameters": {
        "jsCode": "const triggerId = $('Gmail Trigger').item.json.id;\nconst threadItems = $input.all().map(i => i.json);\n\nconst alreadyReplied = threadItems.some(msg =>\n  (msg.labels || []).some(l => l.name === 'SENT')\n);\n\nconst awaitingReason = threadItems.some(msg =>\n  (msg.labels || []).some(l => l.name === 'awaiting response')\n);\n\nconst originalMessage = threadItems.find(msg => msg.id === triggerId) || threadItems[0];\n\nreturn [{\n  json: {\n    ...originalMessage,\n    alreadyReplied,\n    awaitingReason\n  }\n}];"
      },
