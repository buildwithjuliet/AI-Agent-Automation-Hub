    {
      "parameters": {
        "jsCode": "const rows = $('Get Activity Log Rows').all().map(item => item.json);\nconst labeledCount = $input.all().length;\nconst now = new Date();\nconst cutoff = new Date(now.getTime() - 24 * 60 * 60 * 1000);\n\nconst todayRows = rows.filter(r => r.timestamp && new Date(r.timestamp) >= cutoff);\nconst counts = {};\nfor (const r of todayRows) {\n  const cat = r.category || 'Uncategorized';\n  counts[cat] = (counts[cat] || 0) + 1;\n}\nconst breakdown = Object.entries(counts).map(([cat, count]) => cat + ': ' + count).join(', ') || 'nothing processed today';\n\nreturn [{ json: { totalProcessed: todayRows.length, breakdown, labeledCount } }];"
      },
