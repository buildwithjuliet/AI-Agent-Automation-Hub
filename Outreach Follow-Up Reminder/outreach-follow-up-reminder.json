{
  "name": "Outreach Follow-Up Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "dataSourceId": {
          "__rl": true,
          "value": "YOUR_LEAD_PIPELINE_DATA_SOURCE_ID",
          "mode": "list",
          "cachedResultName": "Lead Pipeline"
        },
        "returnAll": true,
        "options": {}
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 3,
      "position": [224, 0],
      "name": "Get many database pages",
      "credentials": {
        "notionApi": {
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ $json.property_follow_up_date.start }}",
              "operator": {
                "operation": "equals",
                "type": "dateTime"
              },
              "rightValue": "={{ $today }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [384, 64],
      "name": "Filter"
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ \"Follow-up due: \" + $json.property_name + ($json.property_company ? \" (\" + $json.property_company + \")\" : \"\") + \"\\n\\nNext action: \" + ($json.property_next_action || \"Not set\") + \"\\nStage: \" + ($json.property_stage || \"Not set\") + \"\\nFollow up date: \" + $json.property_follow_up_date }}",
        "additionalFields": { "appendAttribution": false }
      },
      "name": "Send Telegram Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [608, 64],
      "credentials": {
        "telegramApi": {
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Get many database pages", "type": "main", "index": 0 }]]
    },
    "Get many database pages": {
      "main": [[{ "node": "Filter", "type": "main", "index": 0 }]]
    },
    "Filter": {
      "main": [[{ "node": "Send Telegram Reminder", "type": "main", "index": 0 }]]
    }
  }
}
