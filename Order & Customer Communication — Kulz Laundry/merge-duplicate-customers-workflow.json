    {
      "parameters": {
        "jsCode": "const newPage = $('New Customer Created').first().json;\nconst candidates = $input.all().map((item) => item.json).filter((c) => c.id !== newPage.id);\n\nfunction normalizePhone(p) {\n  if (!p) return '';\n  let digits = String(p).replace(/\\D/g, '');\n  if (digits.indexOf('234') === 0) digits = digits.slice(3);\n  else if (digits.indexOf('0') === 0) digits = digits.slice(1);\n  return digits;\n}\n\nfunction normalizeName(n) {\n  return String(n || '').trim().toLowerCase();\n}\n\nconst newPhoneNorm = normalizePhone(newPage.Phone);\nconst newNameNorm = normalizeName(newPage.Name);\n\nconst phoneMatch = candidates.find((c) => newPhoneNorm !== '' && normalizePhone(c.property_phone) === newPhoneNorm);\nconst nameMatch = phoneMatch ? null : candidates.find((c) => newNameNorm !== '' && normalizeName(c.property_name) === newNameNorm);\n\nlet matchType = 'none';\nlet oldPageId = null;\nif (phoneMatch) {\n  matchType = 'phone';\n  oldPageId = phoneMatch.id;\n} else if (nameMatch) {\n  matchType = 'name';\n  oldPageId = nameMatch.id;\n}\n\nreturn [{ json: { matchType: matchType, oldPageId: oldPageId, newPageId: newPage.id, newName: newPage.Name, newPhone: newPage.Phone } }];"
      },
