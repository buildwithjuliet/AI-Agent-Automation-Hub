        "jsCode": "const job = $(\"Job\").first().json;\nconst words = function (s) { return String(s || \"\").toLowerCase().split(/[,\\n;]+/).map(function (w) { return w.trim(); }).filter(function (w) { return w.length > 1; }); };\nconst keep = words(job.keep), trash = words(job.trash);\nconst buy = [\"order confirmation\", \"your order\", \"order #\", \"receipt\", \"invoice\", \"payment received\", \"payment confirmation\", \"has shipped\", \"out for delivery\", \"booking confirmation\", \"reservation\", \"tracking number\", \"your purchase\", \"refund\"];\nreturn $input.all().map(function (item) {\n  const j = item.json;\n  const text = (String(j.subject) + \" \" + String(j.from) + \" \" + String(j.snippet)).toLowerCase();\n  const hit = function (list) { return list.some(function (w) { return text.indexOf(w) !== -1; }); };\n  let route = \"ai\";\n  if (hit(keep)) route = \"archive\";\n  else if (hit(buy)) route = \"leave\";\n  else if (hit(trash)) route = \"trash\";\n  else if (/CATEGORY_(PROMOTIONS|SOCIAL|FORUMS)/.test(String(j.labels || \"\"))) route = \"trash\";\n  return { json: Object.assign({}, j, { route: route }) };\n});"
