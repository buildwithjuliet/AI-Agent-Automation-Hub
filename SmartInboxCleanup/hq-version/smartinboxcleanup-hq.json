    {
      "parameters": {
        "jsCode": "const token = $(\"Attach token\").first().json.access_token;\nconst out = [];\nitems.forEach(function (item) {\n  if (item.json.dummy === true) return;\n  out.push({ json: { action: String(item.json.text || \"\").trim().toLowerCase() === \"archive\" ? \"archive\" : \"trash\", id: item.json.id, threadId: item.json.threadId, access_token: token } });\n});\n$(\"Prefilter\").all().forEach(function (i) {\n  const r = i.json.route;\n  if (r === \"archive\" || r === \"trash\") out.push({ json: { action: r, id: i.json.id, threadId: i.json.threadId, access_token: token } });\n});\nif (!out.length) out.push({ json: { action: \"skip\", id: \"none\", threadId: \"\", access_token: token } });\nreturn out;"
      },
